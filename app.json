{
  "expo": {
    "name": "Angelus Domini",
    "slug": "angelus-Domini-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Bell_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Official_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F3A6E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.angelusapp",
      "icon": "./assets/Bell_icon_1.png"
    },
    "android": {
      "package": "com.annieann.angelusapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Bell_icon_1.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/Angelus_Domini_icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-splash-screen",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/bell.png",
          "color": "#2F4A7A",
          "sounds": [
            "./assets/audio/triple_bell.mp3"
          ]
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9cc5775a-9f17-43e7-a424-c086dec06b8c"
      }
    },
    "owner": "anita-04"
  }
}
