{
  "expo": {
    "name": "Angelus Domini",
    "slug": "angelus-domini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bell.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/bell.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F3A6E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.angelusapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.annieann.angelusapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Angelus-domini.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/angelusdominiicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-splash-screen",
      "expo-audio",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8c613d8-e954-40b4-b1fc-579a2774b5fb"
      }
    }
  }
}
