{
  "expo": {
    "name": "Angelus Domini",
    "slug": "angelus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Angelus-domini.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/angelusdominiicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F3A6E"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.angelusapp"
    },

    "android": {
      "package": "com.annieann.angelusapp",

      "adaptiveIcon": {
        "foregroundImage": "./assets/Angelus-domini.png",
        "backgroundColor": "#ffffff"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,

      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },

    "web": {
      "favicon": "./assets/angelusdominiicon.png"
    },

    "plugins": [
      "expo-secure-store",
      "expo-splash-screen",
      "expo-audio",

      [
        "expo-notifications",
        {
          "icon": "./assets/bell.png",
          "color": "#2F4A7A",
          "sounds": []
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "6da1a91f-2298-44e8-af97-b23b170f3b2d"
      }
    }
  }
}