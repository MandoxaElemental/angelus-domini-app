{
  "expo": {
    "name": "Angelus Domini",
    "slug": "angelus-domini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bell.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/bell.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F3A6E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.angelus-app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/angelusdominiicon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/angelusdominiicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/CormorantGaramond-VariableFont_wght.ttf",
            "./assets/fonts/CormorantGaramond-Italic-VariableFont_wght.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Bold.ttf"
          ]
        }
      ],
      "expo-audio",
      "expo-notifications",
      [
        "expo-notifications",
        {
          "icon": "./assets/bell.png",
          "color": "#C9A24A",
          "sounds": "./assets/audio/triple-bell.mp3"
        }
      ],
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8c613d8-e954-40b4-b1fc-579a2774b5fb"
      }
    }
  }
}
